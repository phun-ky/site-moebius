{
  "name": "moebius-site",
  "private": true,
  "description": "asd",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist sourcemaps",
    "prebuild": "npm run clean",
    "build": "vite build",
    "postbuild": "mkdir -p sourcemaps && find dist -name '*.map' -exec mv {} sourcemaps/ \\; && node scripts/build-routes.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --import tsx --enable-source-maps --test \"{src,scripts}/**/__tests__/*.test.{ts,mjs}\"",
    "check:dist": "node scripts/check-dist.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:theme": "node scripts/check-theme.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/phun-ky/moebius-site.git"
  },
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander+github.com@phun-ky.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phun-ky/moebius-site/issues"
  },
  "homepage": "https://github.com/phun-ky/moebius-site#readme",
  "devDependencies": {
    "@testing-library/dom": "^7.29.4",
    "@testing-library/user-event": "^12.7.1",
    "@types/chroma-js": "^2.4.5",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "color-name-list": "^14.51.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-compat": "^3.13.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jest": "^24.4.2",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.23.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "fast-check": "^3.23.2",
    "git-cz": "^4.9.0",
    "playwright-core": "^1.63.0",
    "prettier": "^2.4.1",
    "prettier-eslint": "^13.0.0",
    "stylus": "^0.60.0",
    "terser": "^5.24.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.1.6"
  },
  "dependencies": {
    "@phun-ky/moebius": "^2.1.0",
    "chroma-js": "^2.4.2",
    "diff-dom": "^5.0.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  }
}
