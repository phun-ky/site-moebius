{
  "name": "moebius-site",
  "private": true,
  "description": "moebius.wtf: color palettes from two colors, a color blind simulator, and the code to use them",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist sourcemaps",
    "prebuild": "npm run clean",
    "build": "vite build",
    "postbuild": "mkdir -p sourcemaps && find dist -name '*.map' -exec mv {} sourcemaps/ \\; && node scripts/build-routes.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --enable-source-maps --test \"{src,scripts}/**/__tests__/*.test.{ts,mjs}\"",
    "test:coverage": "c8 npm test",
    "test:e2e": "playwright test",
    "render:assets": "node scripts/render-assets.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:html": "node scripts/check-html.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-links.mjs --external",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:keyboard": "node scripts/check-keyboard.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:origins": "node scripts/check-origins.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:theme": "node scripts/check-theme.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/phun-ky/moebius-site.git"
  },
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander+github.com@phun-ky.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phun-ky/moebius-site/issues"
  },
  "homepage": "https://github.com/phun-ky/moebius-site#readme",
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.64.0",
    "@types/chroma-js": "^2.4.5",
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.6",
    "axe-core": "^4.14.0",
    "c8": "^12.0.0",
    "color-name-list": "^14.51.0",
    "eslint": "^10.12.0",
    "eslint-config-phun-ky": "^2.0.10",
    "fast-check": "^3.23.2",
    "global-jsdom": "^30.0.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@phun-ky/moebius": "^2.2.0",
    "chroma-js": "^2.4.2",
    "diff-dom": "^5.2.1",
    "prismjs": "^1.30.0"
  }
}
