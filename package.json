{
  "name": "moebius-site",
  "private": true,
  "description": "asd",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist sourcemaps",
    "prebuild": "npm run clean",
    "build": "vite build",
    "postbuild": "mkdir -p sourcemaps && find dist -name '*.map' -exec mv {} sourcemaps/ \\; && node scripts/build-routes.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --enable-source-maps --test \"{src,scripts}/**/__tests__/*.test.{ts,mjs}\"",
    "check:dist": "node scripts/check-dist.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:theme": "node scripts/check-theme.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/phun-ky/moebius-site.git"
  },
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander+github.com@phun-ky.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phun-ky/moebius-site/issues"
  },
  "homepage": "https://github.com/phun-ky/moebius-site#readme",
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@types/chroma-js": "^2.4.5",
    "@types/node": "^24.19.1",
    "color-name-list": "^14.51.0",
    "eslint": "^10.12.0",
    "eslint-config-phun-ky": "^2.0.10",
    "fast-check": "^3.23.2",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "terser": "^5.24.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.1.6"
  },
  "dependencies": {
    "@phun-ky/moebius": "^2.1.0",
    "chroma-js": "^2.4.2",
    "diff-dom": "^5.0.4"
  }
}
