{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true,
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "components": ["./src/components"],
      "components/*": ["./src/components/*"],
      "config": ["./src/config"],
      "config/*": ["./src/config/*"],
      "features": ["./src/features"],
      "features/*": ["./src/features/*"],
      "lib": ["./src/lib"],
      "lib/*": ["./src/lib/*"],
      "pages": ["./src/pages"],
      "pages/*": ["./src/pages/*"],
      "styles": ["./src/styles"],
      "styles/*": ["./src/styles/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
