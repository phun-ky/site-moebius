    },
    "well-transparent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6235, 0.6588, 0.6784],
        "hex": "#9fa8ad",
        "alpha": 0.1
      }
    },
    "input-background": {
      "$value": "{color.well}"
    },
    "notice-warning": {
      "$value": {
