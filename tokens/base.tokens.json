{
  "$description": "The moebius.wtf design tokens that are the same in both themes. Format: Design Tokens Community Group 2025.10.",
  "color": {
    "$type": "color",
    "link": {
      "$value": "{color.brand}"
    },
    "background-gradient": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.149, 0.1647, 0.2314],
        "hex": "#262a3b"
      }
    },
    "well-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6235, 0.6588, 0.6784],
        "hex": "#9fa8ad",
        "alpha": 0.5
